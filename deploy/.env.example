# 域名(必填): 解析到服务器 IP 后填这里, Caddy 会自动申请 HTTPS 证书。
DOMAIN=interview.example.com

# MySQL
MYSQL_ROOT_PASSWORD=请改成强密码-root
MYSQL_DATABASE=interview
MYSQL_USER=interview
MYSQL_PASSWORD=请改成强密码-user

# 应用签名密钥(必填): 一串随机长字符串。
# 上线后不要更换 —— 换掉它会让所有已发出的候选人链接/令牌全部失效。
APP_SECRET=请改成一串很长的随机字符串

# 管理员注册邀请码(注册管理员账号时填写)
ADMIN_INVITE_CODE=请改成你自己的邀请码

# 大模型(可选)。不填则用规则评分, 报告会标注"规则评分"。
# 火山方舟示例:
#   LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
#   LLM_MODEL=deepseek-v4-1-flash-260910
#   LLM_API_MODE=chat
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_API_MODE=chat
